<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/catalog">Home</a>
        <a href="/catalog/books">Livros</a>
        <a href="/catalog/authors">Autores</a>
        <a href="/catalog/genres">Gêneros</a>
        <a href="/catalog/bookinstances">Instâncias</a>
      </nav>
    </header>

    <main>
      <h1><%= title %></h1>
      <% if (genre_list && genre_list.length) { %>
        <ul>
          <% genre_list.forEach(genre => { %>
            <li><a href="<%= genre.url %>"><%= genre.name %></a></li>
          <% }); %>
        </ul>
      <% } else { %>
        <p>Nenhum gênero encontrado.</p>
      <% } %>
    </main>

    <footer class="site-footer">Biblioteca Local</footer>
  </body>
</html>