<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/catalog">Home</a>
        <a href="/catalog/books">Livros</a>
        <a href="/catalog/authors">Autores</a>
        <a href="/catalog/genres">Gêneros</a>
        <a href="/catalog/bookinstances">Instâncias</a>
      </nav>
    </header>

    <main>
      <h1><%= title %></h1>
      <% if (author_list && author_list.length) { %>
        <ul>
          <% author_list.forEach(author => { %>
            <li><a href="<%= author.url %>"><%= author.name %></a> (<%= author.date_of_birth_formatted %> - <%= author.date_of_death_formatted %>)</li>
          <% }); %>
        </ul>
      <% } else { %>
        <p>Nenhum autor encontrado.</p>
      <% } %>
    </main>

    <footer class="site-footer">Biblioteca Local</footer>
  </body>
</html>