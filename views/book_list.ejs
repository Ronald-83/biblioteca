<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/catalog">Home</a>
        <a href="/catalog/books">Livros</a>
        <a href="/catalog/authors">Autores</a>
        <a href="/catalog/genres">Gêneros</a>
        <a href="/catalog/bookinstances">Instâncias</a>
      </nav>
    </header>

    <main>
      <h1><%= title %></h1>
      <% if (book_list && book_list.length) { %>
        <ul>
          <% book_list.forEach(book => { %>
            <li><a href="<%= book.url %>"><%= book.title %></a> - <%= book.author.name %></li>
          <% }); %>
        </ul>
      <% } else { %>
        <p>Nenhum livro encontrado.</p>
      <% } %>
    </main>

    <footer class="site-footer">Biblioteca Local</footer>
  </body>
</html>