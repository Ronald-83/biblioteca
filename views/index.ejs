<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/">Home</a>
        <a href="/catalog/books">Livros</a>
        <a href="/catalog/authors">Autores</a>
        <a href="/catalog/genres">Gêneros</a>
        <a href="/catalog/bookinstances">Instâncias de Livros</a>
        <a href="/futebol">Futebol</a>
        <a href="/produtos">Produtos</a>
      </nav>
    </header>

    <main>
      <h1><%= title %></h1>
      <p>Bem-vindo à Biblioteca Local! Aqui você pode explorar nossa coleção de livros.</p>

      <div class="stats-container">
        <div class="stat-card">
          <h3>Livros</h3>
          <p><%= book_count %></p>
        </div>
        <div class="stat-card">
          <h3>Cópias Disponíveis</h3>
          <p><%= book_instance_available_count %></p>
        </div>
        <div class="stat-card">
          <h3>Total de Cópias</h3>
          <p><%= book_instance_count %></p>
        </div>
        <div class="stat-card">
          <h3>Autores</h3>
          <p><%= author_count %></p>
        </div>
        <div class="stat-card">
          <h3>Gêneros</h3>
          <p><%= genre_count %></p>
        </div>
      </div>

      <div class="intro">
        <p>Explore nossa coleção navegando pelas categorias acima.</p>
      </div>
    </main>

    <footer class="site-footer">Biblioteca Local - Projeto Express</footer>
  </body>
</html>
